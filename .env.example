# Copy to .env.local (ignored by git) and fill in.

# Where the front end sends API requests. Leave empty to keep the shop simulated
# (cart in the browser, no real orders). "/api" is the value for both local dev and
# production: in dev, Vite forwards /api to API_PROXY_TARGET; in production, the host
# rewrites /api to the backend (see vercel.json).
VITE_API_URL=

# Dev only: the backend running on your machine.
API_PROXY_TARGET=http://localhost:8000
